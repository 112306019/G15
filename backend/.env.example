# 複製這份檔案為 .env 並填入實際值，.env 不會被提交到版控

SECRET_KEY=django-insecure-change-me

# ------------------------------------------------------------------------------
# Database (MySQL)
# ------------------------------------------------------------------------------
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_HOST=
DB_PORT=14195

# ------------------------------------------------------------------------------
# Email
# 留空 EMAIL_HOST_USER 時本機開發會自動改用 console backend（信件內容印在終端機，不會真的寄出）
# ------------------------------------------------------------------------------
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=KOC Platform <no-reply@kocplatform.com>

# ------------------------------------------------------------------------------
# ECPay 綠界科技（商品訂單付款）
# 測試環境 MerchantID/HashKey/HashIV 見 developers.ecpay.com.tw 公開測試帳號
# 正式環境請向綠界申請專屬帳號，絕對不要提交到版控
# ------------------------------------------------------------------------------
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# stage：測試環境 / production：正式環境
ECPAY_ENV=stage
# 綠界 Server-to-Server 付款結果通知網址（ReturnURL），必須是可公開訪問的 URL（本機開發需用 ngrok 等工具轉發，且不可帶 port）
ECPAY_RETURN_URL=https://your-domain.example.com/api/payments/ecpay/notify/
# 消費者付款完成後，綠界把瀏覽器導回的網址（OrderResultURL）。這條一樣要打後端、要能公開訪問，
# 後端收到後才會再把瀏覽器轉導去 FRONTEND_BASE_URL 底下的結果頁 —— 不能直接填前端網址
ECPAY_ORDER_RESULT_URL=https://your-domain.example.com/api/payments/ecpay/result/

# 前端網站網域，後端驗證完 OrderResultURL 通知後會導向 {FRONTEND_BASE_URL}/checkout/result?order_id=...
FRONTEND_BASE_URL=http://localhost:5173
